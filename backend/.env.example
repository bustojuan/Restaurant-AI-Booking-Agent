HOST=127.0.0.1
PORT=8001
DATABASE_URL=sqlite:///./booking.db
# Generate once: python -c "import secrets; print(secrets.token_urlsafe(32))"
LOCAL_API_TOKEN=change-this-local-token-at-least-24-chars
CORS_ORIGINS=["http://localhost:5173"]
SEED_MOCK_DATA=true
CALL_DELAY_SECONDS=0.1
CALL_TIMEOUT_SECONDS=5
# Optional local catalog. No external image requests by default.
# IMAGE_CATALOG_PATH=./data/verified-images.json

# LangGraph defaults: deterministic simulation, no paid API requests.
AI_EXTRACTION_MODE=deterministic
AI_MAX_STEPS=1000
REASONING_MODEL=gpt-6-luna
VOICE_MODEL=gpt-live-1
VOICE_NAME=marin
AI_RETENTION_DAYS=30
LANGSMITH_TRACING_ENABLED=false
# OPENAI_API_KEY=
VOICE_SANDBOX_ENABLED=false
VOICE_MAX_SECONDS=180
VOICE_MAX_DELEGATIONS=8
APPROVAL_WAIT_SECONDS=30

# Real calls require ALL guards, own test numbers and an explicit REST authorization.
REAL_TELEPHONY_ENABLED=false
TELEPHONY_GATEWAY_PORT=8002
TELEPHONY_START_HOUR=10
TELEPHONY_END_HOUR=20
TELEPHONY_ALLOWED_NUMBERS=[]
# Independent administrator token for Control Center history and deterministic Playground.
# Use at least 24 random characters, different from LOCAL_API_TOKEN.
ADMIN_API_TOKEN=change-this-admin-token-at-least-24-chars
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TELEPHONY_PUBLIC_ORIGIN=https://your-voice-only-tunnel.example
# Set conservative EUR tariffs and a reasoning allowance per call; do not guess charges.
# TELEPHONY_COST_PER_MINUTE=
# LIVE_COST_PER_MINUTE=
# REASONING_RESERVED_COST_PER_CALL=

