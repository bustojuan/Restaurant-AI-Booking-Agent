          "anyOf": [
            {
              "enum": [
                "DRAFT",
                "READY",
                "RUNNING",
                "WAITING_FOR_USER",
                "CONFIRMED",
                "EXHAUSTED",
                "CANCELLED",
                "FAILED",
                "PENDING",
                "REJECTED",
                "AMBIGUOUS",
                "NEEDS_USER_ACTION"
