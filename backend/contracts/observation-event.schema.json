        "result": {
          "anyOf": [
            {
              "enum": [
                "NO_AVAILABILITY",
                "OFFER",
                "OFFER_ACCEPTABLE",
                "CONFIRMED",
                "NOT_CONFIRMED",
                "ERROR",
                "TIMEOUT",
                "FAILED",
                "CANCELLED",
                "UNCERTAIN",
                "DECLINED",
                "DECLINED_AI",
