        "status": {
          "anyOf": [
            {
              "enum": [
                "DRAFT",
                "READY",
                "RUNNING",
                "WAITING_FOR_USER",
                "CONFIRMED",
                "EXHAUSTED",
                "CANCELLED",
                "FAILED",
                "PENDING",
                "REJECTED",
                "AMBIGUOUS",
