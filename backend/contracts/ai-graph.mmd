---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	load(load)
	planning(planning)
	supervisor(supervisor)
	research(research)
	prepare_call(prepare_call)
	voice_session(voice_session)
	negotiation(negotiation)
	verification(verification)
	human_approval(human_approval)
	pause(pause)
	memory(memory)
	evaluation(evaluation)
	__end__([<p>__end__</p>]):::last
	__start__ --> load;
	human_approval --> supervisor;
	load --> planning;
	memory --> evaluation;
	negotiation --> verification;
	pause --> supervisor;
	planning --> supervisor;
	prepare_call --> voice_session;
	research --> prepare_call;
	supervisor -. &nbsp;approval&nbsp; .-> human_approval;
	supervisor -. &nbsp;finish&nbsp; .-> memory;
	supervisor -.-> pause;
	supervisor -. &nbsp;call&nbsp; .-> research;
	verification --> supervisor;
	voice_session --> negotiation;
	evaluation --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc

